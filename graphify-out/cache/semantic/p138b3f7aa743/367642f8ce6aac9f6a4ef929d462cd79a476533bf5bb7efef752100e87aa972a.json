{"nodes": [{"id": "dokumentasjon_help_desk_survivors", "label": "Help Desk Survivors (game overview)", "file_type": "document", "source_file": "DOKUMENTASJON.md", "source_location": "lines 1-8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal competition game for Help Forsikring; static files only (HTML/CSS/ES modules), no build step, no npm packages, no external assets, ~0.3 MB."}, {"id": "dokumentasjon_dagens_vakt", "label": "Dagens vakt (seeded daily randomness)", "file_type": "rationale", "source_file": "DOKUMENTASJON.md", "source_location": "lines 239-241", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All randomness comes from a seeded mulberry32 generator keyed by today's date in Norwegian time, split into separate streams (spawn timing, spawn position, urgent/boss, upgrade cards, Ny PC drops, energy drink placement, Fjernstyring, Dobbel skjerm, appearance). Math.random() is never used, so everyone plays the same round."}, {"id": "dokumentasjon_leaderboard", "label": "Daily leaderboard (toppliste)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 26-43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stored in server/data/leaderboard.db (SQLite, movable with DATA_DIR); not to be placed in OneDrive/SharePoint-synced folders because sync can lock the file. Resets at midnight Norwegian time, one entry per name, server rejects unrealistic scores and rate-limits submissions."}, {"id": "dokumentasjon_settings", "label": "Settings menu (Innstillinger)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 45-61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sound muted by default because it is an office. Stored locally, applies immediately. Every screen sees exactly 640x360 of map regardless of game size."}, {"id": "dokumentasjon_characters", "label": "Four playable characters", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 63-81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Odyssefs, Johannes, Jin, Julian (IT-avdelingen), each with starting weapon and bonus in CONFIG.characters; appearance in js/figures.js (PLAYERS, drawPortrait). Reference photos are not in the project."}, {"id": "dokumentasjon_weapon_combinations", "label": "Weapons, passives and combinations", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 83-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "11 weapons (max 4), 12 passives (max 6). Weapon at level 8 plus the right passive yields a combination. Numbers in CONFIG.weapons and CONFIG.newWeapons."}, {"id": "dokumentasjon_passord_reset", "label": "Passord-reset (chain weapon) / Tofaktor", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "line 90", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dokumentasjon_teams_varsel", "label": "Teams-varsel (homing alerts) / Allm\u00f8te p\u00e5 Teams", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "line 93", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dokumentasjon_skytsengelen", "label": "Skytsengelen (guardian angel weapon)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 95-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throws mini-printers; fixed cap of simultaneous mini-printers (2, 4, 6; 10 as combination Himmelsk serviceavtale) identical for all players to keep determinism and performance."}, {"id": "dokumentasjon_dobbel_skjerm", "label": "Dobbel skjerm (passive with own RNG stream)", "file_type": "rationale", "source_file": "DOKUMENTASJON.md", "source_location": "lines 97-98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses its own randomness stream so the same choices give the same round for everyone."}, {"id": "dokumentasjon_haster_sender", "label": "\u00abHaster!\u00bb-avsenderen (ranged email lawyer)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 101-104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appears from 2:30, keeps 150-200 px away, telegraphs each shot 0.5 s. Caps: 15% of lawyers, 30 at once, 60 enemy projectiles total. Numbers in CONFIG.sender and CONFIG.enemyShots."}, {"id": "dokumentasjon_bosses", "label": "Bosses (fixed order, mandatory)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 106-130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bosses at 3:00, 6:00, 9:00, 12:00 then Johan every 3 min. All attacks are telegraphed (0.65 s). While a boss is out, 55% fewer regular lawyers; a distant boss jogs to catch up. Names/lines/numbers in CONFIG.bosses; appearance in js/figures.js."}, {"id": "dokumentasjon_sparken", "label": "\u00abDu har f\u00e5tt sparken!\u00bb (fired on boss timeout)", "file_type": "rationale", "source_file": "DOKUMENTASJON.md", "source_location": "lines 108-110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bosses are mandatory: if the countdown runs out the game freezes, the boss looks disappointed, and the run ends as fired. Score can still be submitted; leaderboard shows a moving box icon."}, {"id": "dokumentasjon_nordic_konsulenten", "label": "N\u00f8rdic-konsulenten (boss 1, 3:00)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 114, 126-127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "N\u00f8rdic is a fictional company with its own logo (braces around an N) in forest green and lime, to avoid using any real brand."}, {"id": "dokumentasjon_multifunksjonsmonsteret", "label": "Multifunksjonsmonsteret (boss 2, 6:00)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "line 115", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dokumentasjon_fristen_boss", "label": "\u00abFristen er om 2 minutter!\u00bb (boss 3, 9:00)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "line 116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dokumentasjon_johan", "label": "Johan (final boss, 12:00, returns every 3 min)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 117-118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reference photo used only as a model, not included in the project."}, {"id": "dokumentasjon_config_js", "label": "js/config.js (all balance numbers)", "file_type": "document", "source_file": "DOKUMENTASJON.md", "source_location": "lines 132-149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single place for every tunable number with a comment per field: spawn.rate, scaling.*, level, weapons.<id>.levels, combination.stats, enemies.urgent, bosses, energyDrink, limits.weapons, characters, sender, enemyShots."}, {"id": "dokumentasjon_simulate", "label": "tools/simulate.js (bot balance simulator)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 151-166", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bots play full rounds in seconds; reports survival time, bosses helped, fired. Also checks determinism (two equal rounds give identical results, including Dobbel skjerm) and that lawyer appearance never affects gameplay. --statistikk runs 10 days x 4 characters."}, {"id": "dokumentasjon_measure_weapons", "label": "tools/measure-weapons.js (help per second)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 168-170", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dokumentasjon_build_font", "label": "tools/build-font.js (font generator)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 196-198", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dokumentasjon_map", "label": "Office map (2560x1440, zones, decor, doors)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 172-182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zones in SONER, decor in lagPynt(), doors/elevators in DOERER, glass walls in GLASS (js/map.js); size and wall thickness in CONFIG.map. Decor never blocks movement, only outer walls do."}, {"id": "dokumentasjon_pixel_graphics", "label": "Code-drawn pixel graphics (palette-indexed grids)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 184-195", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All graphics drawn in code via js/pixel.js; lawyers composed from layers (skin 7, age, body, hairstyle 10, hair colour 6, glasses, beard, earrings, tie/scarf, skirt/trousers) with appearance drawn from its own RNG stream so it never affects gameplay."}, {"id": "dokumentasjon_kontorpiksel", "label": "KontorPiksel pixel font", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 196-198", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-made with \u00e6, \u00f8, \u00e5; glyphs in js/pixelfont.js; TTF rebuilt with tools/build-font.js; CC0."}, {"id": "dokumentasjon_debug_mode", "label": "Debug mode (?debug overlay and buttons)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 200-219", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Performance overlay (FPS, ms per frame split update/draw, entity counts, memory, quality level, help/s per weapon). Rounds using debug buttons cannot be submitted to the leaderboard."}, {"id": "dokumentasjon_stresstest", "label": "Stress test (5 min, 400 lawyers, utenGPU)", "file_type": "concept", "source_file": "DOKUMENTASJON.md", "source_location": "lines 213-217", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "&utenGPU forces all drawing onto the CPU, the worst case matching office PCs without GPU support."}, {"id": "dokumentasjon_file_overview", "label": "File overview (js modules, server, tools)", "file_type": "document", "source_file": "DOKUMENTASJON.md", "source_location": "lines 221-237", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "dokumentasjon_help_desk_survivors", "target": "endringslogg_version_2_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DOKUMENTASJON.md", "source_location": "line 8", "weight": 1.0}, {"source": "dokumentasjon_leaderboard", "target": "js_leaderboard_fetchleaderboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DOKUMENTASJON.md", "source_location": "line 39", "weight": 1.0}, {"source": "dokumentasjon_leaderboard", "target": "js_leaderboard_submitscore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DOKUMENTASJON.md", "source_location": "line 39", "weight": 1.0}, {"source": "dokumentasjon_characters", "target": "dokumentasjon_config_js", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DOKUMENTASJON.md", "source_location": 