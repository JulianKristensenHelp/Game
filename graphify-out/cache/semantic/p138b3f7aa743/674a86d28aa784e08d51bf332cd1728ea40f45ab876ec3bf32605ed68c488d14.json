{"nodes": [{"id": "readme_help_desk_survivors", "label": "Help Desk Survivors (README overview)", "file_type": "document", "source_file": "README.md", "source_location": "lines 1-28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Survivors-style (Vampire Survivors-like) office browser game; weapons fire automatically; all in-game text in Norwegian bokm\u00e5l."}, {"id": "readme_no_build_step", "label": "Plain JavaScript, no build step", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 14-15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HTML5 Canvas 2D and ES modules; no npm packages, external scripts, images or sound files; sprites, font and sound generated in code (~0.4 MB)."}, {"id": "readme_dagens_vakt", "label": "Today's shift (Dagens vakt) seeding", "file_type": "concept", "source_file": "README.md", "source_location": "lines 24-25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_bosses", "label": "Four bosses in fixed order, mandatory", "file_type": "concept", "source_file": "README.md", "source_location": "lines 21-23, 72-73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_requirements", "label": "Requirements: Node.js 22.5+ with node:sqlite", "file_type": "concept", "source_file": "README.md", "source_location": "lines 30-33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in node:sqlite means no npm install."}, {"id": "readme_quick_start", "label": "Quick start (npm start / start.ps1)", "file_type": "document", "source_file": "README.md", "source_location": "lines 35-64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be served over http(s) since browsers block ES modules on file://. start.ps1 uses the Node runtime bundled with VS Code. Env va